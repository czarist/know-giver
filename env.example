# Know Giver — AI Models (GLM / Z.ai)
# OpenAI-compatible endpoint

OPENAI_API_BASE=https://api.z.ai/api/paas/v4/

# === API KEY (cole aqui) ===
OPENAI_API_KEY=


# Models by task
# Flagship for heavy tasks (study plan generation)
MODEL_STUDY_PLAN=glm-5.3

# Fast model for lessons, quizzes and real-time tutoring
MODEL_TUTOR=glm-5.3-flash

# Quiz generation
MODEL_QUIZ=glm-5.3-flash

# Answer correction
MODEL_CORRECTION=glm-5.3-flash

# Vision / PDF analysis (if needed)
MODEL_VISION=glm-5.3-flash

# Free fallback for tests
MODEL_FALLBACK=glm-4.7-flash

# Optional: Coding Plan endpoint (if you use it for development)
# OPENAI_API_BASE=https://api.z.ai/api/coding/paas/v4
