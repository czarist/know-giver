# Know Giver — AI settings
# Copy to `.env` (next to the project, or next to know-giver.exe when installed)
# and fill in your key. Everything here can also be set in the app's first run
# and Settings, which take precedence once saved.

# OpenAI-compatible endpoint (Z.ai/GLM shown; for Ollama use http://localhost:11434/v1)
OPENAI_API_BASE=https://api.z.ai/api/paas/v4/
OPENAI_API_KEY=

# Models by task
# Flagship for heavy tasks (study plan generation)
MODEL_STUDY_PLAN=glm-5.3
# Fast model for lessons and real-time tutoring
MODEL_TUTOR=glm-5.3-flash
# Quiz generation
MODEL_QUIZ=glm-5.3-flash
# Answer correction
MODEL_CORRECTION=glm-5.3-flash
# Used when a model is rate limited or unavailable
MODEL_FALLBACK=glm-4.7-flash

# Reads images: scanned PDFs and photos of written answers.
# Leave empty to keep image uploads disabled.
MODEL_VISION=glm-5.3-flash
# Optional: a different model family to double-check handout answer keys.
MODEL_VERIFIER=

# Optional: where the app keeps its database and models
# (default: %LOCALAPPDATA%\KnowGiver)
# KG_DATA_DIR=

# Optional: Z.ai Coding Plan endpoint (for development)
# OPENAI_API_BASE=https://api.z.ai/api/coding/paas/v4
# MODEL_CODING=glm-5.3
